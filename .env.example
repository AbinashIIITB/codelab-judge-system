# ============================================================================
# CodeLab environment configuration
# Copy to .env and adjust. Values below are the local-development defaults.
# ============================================================================

# ---- Database (api, worker) ----
MONGODB_URI=mongodb://localhost:27017/codelab
MONGODB_DB_NAME=codelab

# ---- Redis / BullMQ (api, worker) ----
REDIS_URL=redis://localhost:6379

# ---- API server ----
PORT=4000

# Comma-separated list of allowed browser origins, or "*" to allow any.
# REQUIRED in production — the server refuses to start without it.
CORS_ORIGIN=http://localhost:3000

# Shared secret between the API and the worker. It guards the hidden test case
# endpoint and authenticates the worker's status relay, so live verdicts stop
# reaching the browser if the two sides disagree.
# REQUIRED in production — both services refuse to start without it.
WORKER_API_KEY=dev-worker-key

# ---- Worker ----
# Where the worker reaches the API's WebSocket server to push status updates.
API_WS_URL=http://localhost:4000

# Docker daemon used to sandbox submissions. Accepts unix:// or tcp:// URLs
# as well as a bare socket path.
DOCKER_HOST=unix:///var/run/docker.sock

# ---- Frontend (web) ----
# NOTE: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.
# Setting them only at runtime has no effect on the browser — pass them as
# Docker build args (see docker-compose.yml).
#
# Leave both unset for local development and the frontend falls back to
# port 4000 on whatever host it is served from, which is handy on a LAN.
# Set them explicitly for any real deployment.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ---- Auth (not yet wired up) ----
# next-auth is a dependency but no provider or route is implemented yet, so
# submissions are attributed to the "anonymous" user. These are placeholders
# for when auth lands.
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=change-me
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Environment ----
NODE_ENV=development
