# Host node_modules contain platform-specific binaries and would shadow the
# ones installed inside the image.
node_modules
**/node_modules

# Build output — regenerated inside the image
**/dist
**/.next
**/.turbo
**/*.tsbuildinfo

# VCS and tooling
.git
.gitignore
.github
.vscode
.idea
.DS_Store
**/.DS_Store

# Local environment — never bake secrets into an image
.env
.env.*
!.env.example

# Docs, screenshots and scratch files
*.md
!README.md
*.png
*.excalidraw
*.log
terminal_output.txt
terminal-screenshot.html
rabbitmq_pid.txt
setup_rabbitmq.py
demo_sandbox.sh

# Docker
Dockerfile
**/Dockerfile
docker-compose*.yml
.dockerignore
